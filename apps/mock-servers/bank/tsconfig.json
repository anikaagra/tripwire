{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // The bank imports convex/_generated (Bundler-style, extensionless imports),
    // so it resolves modules the way Convex does. Runtime is tsx either way.
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src", "test"]
}
