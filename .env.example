# Copy to .env.local (Convex/Nessie) and/or .env (agent harness) and fill in values.
# Never commit real values. Both .env and .env.local are gitignored.

# Anthropic (agent harness in apps/agent, and the guard). The harness reads root .env.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the agent model (design doc default is a current Sonnet)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Convex (written by `npx convex dev`; teammates set CONVEX_URL to the shared deployment)
CONVEX_DEPLOYMENT=
CONVEX_URL=

# Nessie (Capital One)
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com
