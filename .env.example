# Copy to .env.local and fill in values. Never commit real values.

# Convex (written by `npx convex dev`; teammates set CONVEX_URL to the shared deployment)
CONVEX_DEPLOYMENT=
CONVEX_URL=

# Nessie (Capital One)
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com

# Bank MCP server (apps/mock-servers/bank)
BANK_BACKEND=local
BANK_SCENARIO=bill-pay
BANK_CONTROL_PORT=8788
# Optional until the currentSession query exists; used only to tag bank writes
TRIPWIRE_SESSION_ID=
