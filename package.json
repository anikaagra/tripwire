{
  "name": "tripwire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "agent": "tsx apps/agent/src/index.ts",
    "inbox": "tsx apps/mock-servers/inbox/src/index.ts",
    "bank": "tsx apps/mock-servers/bank/src/index.ts",
    "proxy": "pnpm --filter @tripwire/proxy start",
    "tripwire:approve": "pnpm --filter @tripwire/proxy tripwire:approve",
    "tripwire:deny": "pnpm --filter @tripwire/proxy tripwire:deny",
    "redteam": "pnpm --filter @tripwire/redteam start",
    "redteam:report": "pnpm --filter @tripwire/redteam report",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "convex:dev": "convex dev",
    "convex:typecheck": "tsc --noEmit -p convex",
    "seed:dev": "convex run devSeed:seed",
    "seed:clear": "convex run devSeed:clear",
    "bank:start": "pnpm --silent --filter @tripwire/mock-bank start",
    "bank:control": "pnpm --silent --filter @tripwire/mock-bank control",
    "bank:test": "pnpm --filter @tripwire/mock-bank test",
    "bank:typecheck": "pnpm --filter @tripwire/mock-bank typecheck"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "convex": "1.48.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
